# Copia este archivo a .env.local y llena los valores reales.
# .env.local nunca se commitea (ver .gitignore, create-next-app ya lo excluye).

# Supabase — Project Settings → API. La service role key NUNCA debe
# exponerse al cliente: solo se usa en src/lib/supabase.ts (server-only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# MiniMax — solo modelo de texto (sin visión). Verificar la URL/modelo
# exactos contra tu plan antes del primer uso; ver el comentario en
# src/lib/minimax.ts si el formato de tu cuenta difiere del asumido.
MINIMAX_API_KEY=
MINIMAX_API_URL=https://api.minimax.io/v1
MINIMAX_MODEL=

# Gate de acceso — contraseña única compartida, sin cuentas individuales.
APP_PASSWORD=
# Cadena aleatoria larga para firmar la cookie de sesión (ej. `openssl rand -hex 32`).
APP_SESSION_SECRET=
